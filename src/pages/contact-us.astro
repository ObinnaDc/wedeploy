---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import StartProjectForm from '../components/StartProjectForm';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://obinnadc.github.io';
const canonicalUrl = new URL(`${base}contact-us/`, siteUrl).toString();
const pageTitle = 'Contact Deploy Studio | Bring your ideas to life faster';
const pageDescription =
  'Contact Deploy Studio to discuss your product idea, MVP, or custom web app and connect with an expert team that can bring it to life in weeks instead of months.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Deploy Studio" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${base}favicon.svg`} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={`${siteUrl}${base}favicon.svg`} />
  </head>
  <body class="bg-white">
    <div class="border-b border-[#e6e8ee]">
      <Navbar current="contact" />
    </div>

    <main>
      <StartProjectForm client:load />

      <section class="mx-auto max-w-[1120px] px-6 pb-[86px] xl:px-0">
        <div class="bg-dark-grid rounded-[8px] px-6 py-[58px] text-center text-white sm:py-[62px]">
          <h2 class="text-[28px] font-bold leading-tight sm:text-[32px]">
            Ready to bring your ideas to <em>life?</em>
          </h2>
          <p class="mx-auto mt-4 max-w-[520px] text-[13px] font-bold leading-[1.45]">
            Your product ideas can start coming to life in weeks instead of months. Embrace the journey ahead and turn your ideas into a reality!
          </p>
          <a
            href="https://cal.com/deploystudio/discovery-call"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex items-center gap-2 rounded-[6px] bg-deploy-blue px-5 py-3 text-[12px] font-bold text-white transition hover:bg-white hover:text-deploy-navy"
          >
            <span aria-hidden="true">&#9742;</span>
            Book a call
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>
