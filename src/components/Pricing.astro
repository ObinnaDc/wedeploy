---
const plans = [
  {
    name: 'Lite',
    price: '$1,000',
    cta: 'Subscribe to lite',
    features: ['Existing projects', 'Unlimited development requests', 'One request at a time', 'Slack communication', 'Pause or cancel anytime', '2-3 days turnaround'],
    featured: false,
  },
  {
    name: 'Pro',
    price: '$3,000',
    cta: 'Subscribe to pro',
    features: ['New and Existing Projects', 'Expert UI/UX Design', 'Priority support', 'Unlimited development requests', 'Two or more requests at a time', 'Slack communication', 'Pause or cancel anytime', '1-3 days turnaround'],
    featured: true,
  },
];
---

<section id="pricing" class="bg-white py-[86px]">
  <div class="mx-auto max-w-[860px] px-6 text-center">
    <h2 class="text-[40px] font-normal leading-tight">Simple and flexible pricing</h2>
    <p class="mx-auto mt-2 max-w-[520px] text-[16px] leading-[1.45] text-[#4d535b]">
      Get started right away and connect with your assigned project team for your project.
    </p>
    <div class="mx-auto mt-8 flex w-fit rounded-[10px] border border-deploy-line bg-white p-1">
      <button class="rounded-[8px] bg-deploy-navy px-5 py-2.5 text-[15px] font-bold text-white">Monthly</button>
      <button class="px-6 py-2.5 text-[15px] text-[#4d535b]">Quarterly</button>
    </div>
  </div>

  <div class="mx-auto mt-12 grid max-w-[860px] gap-4 px-6 md:grid-cols-2">
    {plans.map((plan) => (
      <article
        class:list={[
          'rounded-[12px] border p-6 sm:p-7',
          plan.featured ? 'border-[#c5d9f7] bg-deploy-pro text-deploy-blue' : 'border-deploy-blue bg-white text-deploy-ink',
        ]}
      >
        <h3 class="text-[23px] font-normal">{plan.name}</h3>
        <p class="mt-5 text-[32px] font-normal">{plan.price}</p>
        <div class:list={['my-8 h-px', plan.featured ? 'bg-[#bfd1ed]' : 'bg-deploy-line']}></div>
        <ul class="space-y-4 text-left">
          {plan.features.map((feature) => (
            <li class="flex items-center gap-4 text-[17px]">
              <span class:list={['text-[25px]', plan.featured ? 'text-deploy-blue' : 'text-black']}>&#10003;</span>
              <span class={plan.featured ? 'text-[#07101f]' : 'text-[#111827]'}>{feature}</span>
            </li>
          ))}
        </ul>
        <a
          href="#contact"
          class:list={[
            'mt-9 inline-flex w-full justify-center rounded-[8px] px-5 py-3.5 text-[15px] font-bold transition',
            plan.featured ? 'bg-deploy-blue text-white hover:bg-deploy-navy' : 'bg-deploy-navy text-white hover:bg-deploy-blue',
          ]}
        >
          {plan.cta}
        </a>
      </article>
    ))}
  </div>
</section>
