---
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
---

<section
  id="share-idea-form"
  aria-hidden="true"
  class="fixed inset-0 z-50 hidden overflow-y-auto bg-white"
>
  <div class="border-b border-[#e7e9ee]">
    <div class="mx-auto flex h-[78px] max-w-[928px] items-center justify-between px-6">
      <img src={asset('assets/deploy-logo.svg')} alt="Deploy" class="h-[24px] w-auto" />
      <button
        type="button"
        data-share-idea-close
        aria-label="Close form"
        class="flex h-6 w-6 items-center justify-center rounded-[6px] border border-[#dfe3ea] text-[18px] leading-none text-[#030712] transition hover:border-deploy-blue hover:text-deploy-blue"
      >
        &times;
      </button>
    </div>
  </div>

  <div class="mx-auto max-w-[340px] px-5 pb-24 pt-8 sm:pt-9">
    <div class="text-center">
      <h2 class="text-[30px] font-normal leading-tight text-[#030712]">Share your idea</h2>
      <p class="mt-2 text-[12px] leading-[1.4] text-[#565b63]">Fill out this form and we'd reach out to you.</p>
    </div>

    <form class="mt-8 space-y-4">
      <label class="block">
        <span class="text-[12px] text-[#565b63]">Full Name</span>
        <input
          type="text"
          name="name"
          placeholder="Enter your full name"
          class="mt-1.5 h-9 w-full rounded-[6px] border border-[#d8dce3] px-3 text-[12px] text-[#111827] outline-none transition placeholder:text-[#8a9099] focus:border-deploy-blue focus:ring-2 focus:ring-deploy-blue/10"
        />
      </label>

      <label class="block">
        <span class="text-[12px] text-[#565b63]">Email Address *</span>
        <input
          type="email"
          name="email"
          placeholder="Enter email"
          required
          class="mt-1.5 h-9 w-full rounded-[6px] border border-[#d8dce3] px-3 text-[12px] text-[#111827] outline-none transition placeholder:text-[#8a9099] focus:border-deploy-blue focus:ring-2 focus:ring-deploy-blue/10"
        />
      </label>

      <label class="block">
        <span class="text-[12px] text-[#565b63]">Project url (optional)</span>
        <input
          type="url"
          name="project_url"
          placeholder="Enter project url"
          class="mt-1.5 h-9 w-full rounded-[6px] border border-[#d8dce3] px-3 text-[12px] text-[#111827] outline-none transition placeholder:text-[#8a9099] focus:border-deploy-blue focus:ring-2 focus:ring-deploy-blue/10"
        />
      </label>

      <label class="block">
        <span class="text-[12px] text-[#565b63]">Project description</span>
        <textarea
          name="description"
          placeholder="Enter project description"
          rows="7"
          class="mt-1.5 w-full resize-none rounded-[6px] border border-[#d8dce3] px-3 py-3 text-[12px] text-[#111827] outline-none transition placeholder:text-[#8a9099] focus:border-deploy-blue focus:ring-2 focus:ring-deploy-blue/10"
        ></textarea>
      </label>

      <label class="block">
        <span class="text-[12px] text-[#565b63]">Upload files</span>
        <input type="file" name="files" class="sr-only" multiple accept="image/svg+xml,image/png,image/jpeg,image/gif" />
        <span class="mt-1.5 flex h-[112px] cursor-pointer flex-col items-center justify-center rounded-[6px] border border-dashed border-[#d8dce3] text-center transition hover:border-deploy-blue hover:bg-[#f6fbff]">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-[#f7f8fa] text-[16px] text-[#68707c]">
            &#8682;
          </span>
          <span class="mt-3 text-[11px] leading-[1.5] text-[#384151]">
            <strong class="font-bold text-[#005fff]">Click to upload</strong> or drag and drop
          </span>
          <span class="text-[11px] leading-[1.5] text-[#384151]">SVG, PNG, JPG or GIF (max. 800x400px)</span>
        </span>
      </label>

      <button
        type="submit"
        class="mt-3 rounded-[7px] bg-[#005fff] px-4 py-2.5 text-[12px] font-bold text-white transition hover:bg-deploy-navy"
      >
        Send form
      </button>
    </form>
  </div>
</section>

<script>
  const formOverlay = document.querySelector('#share-idea-form');
  const openButtons = document.querySelectorAll('[data-share-idea-open]');
  const closeButtons = document.querySelectorAll('[data-share-idea-close]');

  const openForm = () => {
    formOverlay?.classList.remove('hidden');
    formOverlay?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  };

  const closeForm = () => {
    formOverlay?.classList.add('hidden');
    formOverlay?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  openButtons.forEach((button) => button.addEventListener('click', openForm));
  closeButtons.forEach((button) => button.addEventListener('click', closeForm));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeForm();
  });
</script>
