---
const social = [
  { src: 'assets/social-mail.svg', alt: 'Mail', href: `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}contact-us/` },
  { src: 'assets/social-x.svg', alt: 'X', href: 'https://x.com/wedeploystudio', external: true },
  { src: 'assets/social-instagram.svg', alt: 'Instagram', href: 'https://www.instagram.com/wedeploystudio', external: true },
  { src: 'assets/social-linkedin.svg', alt: 'LinkedIn', href: 'https://linkedin.com/company/wedeploystudio/', external: true },
];
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
---

<footer class="border-t border-deploy-line bg-white">
  <div class="mx-auto flex max-w-[1120px] flex-col gap-8 px-6 py-9 sm:flex-row sm:items-center sm:justify-between xl:px-0">
    <div>
      <img src={asset('assets/deploy-logo.svg')} alt="Deploy" class="h-[32px] w-auto" />
      <p class="mt-6 text-[14px] text-[#555b63]">&copy; 2026 Deploy Studio. All rights reserved.</p>
    </div>
    <div class="flex items-center gap-4">
      {social.map((item) => (
        <a
          href={item.href}
          aria-label={item.alt}
          class="block transition hover:opacity-75"
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <img src={asset(item.src)} alt="" class="h-8 w-8" loading="lazy" />
        </a>
      ))}
    </div>
  </div>
</footer>
