---
const projects = [
  {
    category: 'WEBSITE BUILDER',
    title: 'HomePages',
    text: 'HomePages is a property listing website builder which uses AI to generate copy of listing site you want to build.',
    image: 'assets/project-bysignal.jpg',
    href: 'https://go.homepages.io/',
    tools: ['stripe', 'figma'],
  },
  {
    category: 'AFFILIATE MANAGEMENT TOOL',
    title: 'Bysignal',
    text: 'The Ultimate Affiliate Management Tool. Seamless multi-device attribution, enhanced tracking, and robust APIs for smarter affiliate management.',
    image: 'assets/project-crater.jpg',
    href: 'https://bysignal.com/',
    tools: ['js', 'stripe', 'figma'],
  },
  {
    category: 'MARKETPLACE & DIRECTORY',
    title: 'AgentHMO',
    text: 'AgentHMO marketplace offering property listings, selling support, services directory, and industry news, with user-friendly navigation and expertise in HMO investments.',
    image: 'assets/project-classicfm.jpg',
    href: 'https://www.agenthmo.co.uk/',
    tools: ['zoho', 'zapier', 'wordpress', 'stripe'],
  },
  {
    category: 'DASHBOARD',
    title: 'ClassicFM',
    text: 'Built to help automate processes at a commercial & industrial printing firm to assist with making sure deliveries are on time & on budget.',
    image: 'assets/project-barterblack.jpg',
    tools: ['stripe', 'googlecloud', 'amazon', 'sage'],
  },
  {
    category: 'AFFILIATE DIRECTORY',
    title: 'Perksome',
    text: 'Reward your community with perks and benefits. Convert more customers with a hundreds of curated business perks. Keep your existing community happy with a local and global deals platform.',
    image: 'assets/project-dealpage.jpg',
    href: 'https://perksome.co/',
    tools: ['stripe', 'figma'],
  },
  {
    category: 'PROTOTYPE',
    title: 'Crater',
    text: 'Crater is a prototype build for a small art company that wanted to start selling art supplies online with a backend dashboard.',
    image: 'assets/project-skilltracker.jpg',
    tools: ['stripe', 'figma'],
  },
  {
    category: 'MARKETPLACE',
    title: 'Barter Black',
    text: 'Transform your business by leveraging the power of bartering. Gain essential services, expand your network, and collaborate within a thriving Black entrepreneurial community.',
    image: 'assets/project-pixelops.jpg',
    href: 'https://barterblack.io/',
    tools: ['stripe', 'figma', 'sendgrid'],
  },
  {
    category: 'PITCH DECKS',
    title: 'Dealpage',
    text: 'Dealpage helps real estate developers raise capital by creating more engaging offering materials that impress investors.',
    image: 'assets/project-perksome.jpg',
    href: 'https://app.dealpage.io/',
    tools: ['stripe', 'figma'],
  },
  {
    category: 'LANDING PAGE',
    title: 'Pixelops',
    text: 'An unlimited graphic design services company that handles services from packaging design to logos and branding, brochures and so much more.',
    image: 'assets/project-homepages.jpg',
    href: 'https://pixelops.design/',
    tools: ['openai', 'figma'],
  },
  {
    category: 'PLAYER TRACKER',
    title: 'Skilltracker',
    text: 'Skilltracker is an all-in one player development platform that helps coaches and managers track player development, share insights with players and their parents, and improve team performance.',
    image: 'assets/project-agenthmo.jpg',
    tools: ['stripe', 'openai', 'figma'],
  },
];
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;

const toolMarks = {
  stripe: '<span class="text-[13px] font-bold text-[#635bff]">stripe</span>',
  figma: '<span class="grid grid-cols-2 gap-[2px]"><span class="h-[7px] w-[7px] rounded-full bg-[#f24e1e]"></span><span class="h-[7px] w-[7px] rounded-full bg-[#ff7262]"></span><span class="h-[7px] w-[7px] rounded-full bg-[#a259ff]"></span><span class="h-[7px] w-[7px] rounded-full bg-[#1abcfe]"></span><span class="col-start-1 h-[7px] w-[7px] rounded-full bg-[#0acf83]"></span></span>',
  js: '<span class="flex h-5 w-5 items-end justify-end bg-[#f7df1e] pr-[2px] pb-[1px] text-[11px] font-bold leading-none text-black">JS</span>',
  zoho: '<span class="flex items-center gap-[2px]"><span class="h-4 w-4 rotate-[-8deg] rounded-[3px] border border-[#ef4444]"></span><span class="h-4 w-4 rotate-[8deg] rounded-[3px] border border-[#22c55e]"></span><span class="h-4 w-4 rotate-[-7deg] rounded-[3px] border border-[#3b82f6]"></span><span class="h-4 w-4 rotate-[8deg] rounded-[3px] border border-[#eab308]"></span></span>',
  zapier: '<span class="text-[13px] font-bold text-[#ff4a00]">zapier</span>',
  wordpress: '<span class="text-[9px] font-semibold text-[#4b5563]">WordPress</span>',
  googlecloud: '<span class="text-[8px] font-semibold"><span class="text-[#4285f4]">Google</span> <span class="text-[#6b7280]">Cloud</span></span>',
  amazon: '<span class="text-[10px] font-bold text-black">amazon</span>',
  sage: '<span class="text-[16px] font-bold text-[#00dc06]">Sage</span>',
  sendgrid: '<span class="text-[8px] font-semibold text-[#374151]">twilio<br/>sendgrid</span>',
  openai: '<span class="text-[11px] font-semibold text-black">OpenAI</span>',
};
---

<section id="work" class="overflow-hidden bg-white py-[94px]">
  <div class="mx-auto max-w-[1120px] px-6 xl:px-0">
    <h2 class="text-[40px] font-normal leading-tight max-[770px]:text-[28px] max-[770px]:leading-[28px]">Some past work</h2>
    <p class="mt-2 text-[16px] text-[#4d535b]">Take a look at some of our work</p>
  </div>

  <div class="hide-scrollbar mx-auto mt-12 flex max-w-[1120px] gap-7 overflow-x-auto px-6 pb-5 xl:px-0">
    {projects.map((project) => (
      <article class="group flex min-h-[492px] w-[420px] shrink-0 flex-col overflow-hidden rounded-[14px] border border-[#dfe5ed] bg-white transition duration-200 hover:-translate-y-1 hover:border-[#b7d8ff] hover:shadow-[0_22px_55px_rgba(8,119,232,0.12)] sm:w-[432px]">
        {project.href ? (
          <a
            href={project.href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`Open ${project.title}`}
            class="flex h-full flex-col"
          >
            <div class="flex h-[252px] items-center justify-center border-b border-[#f1f3f6] bg-white px-8 py-6">
              <img src={asset(project.image)} alt={`${project.title} project preview`} class="max-h-full w-full object-contain" loading="lazy" />
            </div>
            <div class="flex flex-1 flex-col px-8 pb-5 pt-8">
              <p class="text-[13px] font-normal uppercase leading-none text-[#005fff]">{project.category}</p>
              <h3 class="mt-4 text-[25px] font-normal leading-tight text-[#06080f]">{project.title}</h3>
              <p class="mt-3 text-[17px] leading-[1.38] text-[#565b63]">{project.text}</p>
              <div class="mt-auto flex h-8 items-end gap-7 pt-7">
                {project.tools.map((tool) => (
                  <span class="inline-flex h-6 items-center" set:html={toolMarks[tool]} />
                ))}
              </div>
            </div>
          </a>
        ) : (
        <div class="flex h-[252px] items-center justify-center border-b border-[#f1f3f6] bg-white px-8 py-6">
          <img src={asset(project.image)} alt={`${project.title} project preview`} class="max-h-full w-full object-contain" loading="lazy" />
        </div>
        <div class="flex flex-1 flex-col px-8 pb-5 pt-8">
          <p class="text-[13px] font-normal uppercase leading-none text-[#005fff]">{project.category}</p>
          <h3 class="mt-4 text-[25px] font-normal leading-tight text-[#06080f]">{project.title}</h3>
          <p class="mt-3 text-[17px] leading-[1.38] text-[#565b63]">{project.text}</p>
          <div class="mt-auto flex h-8 items-end gap-7 pt-7">
            {project.tools.map((tool) => (
              <span class="inline-flex h-6 items-center" set:html={toolMarks[tool]} />
            ))}
          </div>
        </div>
        )}
      </article>
    ))}
  </div>
</section>
