---
const projects = [
  ['DASHBOARD', 'ClassicFM', 'Built to help automate processes at a commercial & industrial printing firm to assist with making sure deliveries are on time & on budget.', '/assets/project-classicfm.jpg'],
  ['WEBSITE BUILDER', 'HomePages', 'HomePages is a property listing website builder which uses AI to generate copy of listing site you want to build.', '/assets/project-homepages.jpg'],
  ['PITCH DECKS', 'Dealpage', 'Dealpage helps real estate developers raise capital by creating more engaging offering materials that impress investors.', '/assets/project-dealpage.jpg'],
  ['PLAYER TRACKER', 'Skilltracker', 'Skilltracker is an all-in one player development platform that helps coaches and managers track player development, share insights with players and their parents, and improve team performance.', '/assets/project-skilltracker.jpg'],
  ['LANDING PAGE', 'Pixelops', 'An unlimited graphic design services company that handles services from packaging design to logos and branding, brochures and so much more.', '/assets/project-pixelops.jpg'],
  ['PROTOTYPE', 'Crater', 'Crater is a prototype build for a small art company that wanted to start selling art supplies online with a backend dashboard.', '/assets/project-crater.jpg'],
  ['MARKETPLACE & DIRECTORY', 'AgentHMO', 'AgentHMO marketplace offering property listings, selling support, services directory, and industry news.', '/assets/project-agenthmo.jpg'],
  ['AFFILIATE DIRECTORY', 'Perksome', 'Reward your community with perks and benefits. Convert more customers with hundreds of curated business perks.', '/assets/project-perksome.jpg'],
  ['MARKETPLACE', 'Barter Black', 'Transform your business by leveraging the power of bartering within a thriving Black entrepreneurial community.', '/assets/project-barterblack.jpg'],
  ['AFFILIATE MANAGEMENT TOOL', 'Bysignal', 'The ultimate affiliate management tool with multi-device attribution, enhanced tracking, and robust APIs.', '/assets/project-bysignal.jpg'],
];
---

<section id="work" class="overflow-hidden bg-white py-[94px]">
  <div class="mx-auto max-w-[1120px] px-6 xl:px-0">
    <h2 class="text-[40px] font-normal leading-tight">Some past work</h2>
    <p class="mt-2 text-[16px] text-[#4d535b]">Take a look at some of our work</p>
  </div>

  <div class="hide-scrollbar mx-auto mt-12 flex max-w-[1120px] gap-7 overflow-x-auto px-6 pb-5 xl:px-0">
    {projects.map(([category, title, text, image]) => (
      <article class="w-[420px] shrink-0 overflow-hidden rounded-[10px] border border-deploy-line bg-white shadow-soft">
        <div class="flex h-[250px] items-center justify-center border-b border-[#f1f3f6] bg-white p-6">
          <img src={image} alt={`${title} project preview`} class="max-h-full w-full object-contain" loading="lazy" />
        </div>
        <div class="p-6 pt-8">
          <p class="text-[12px] font-normal uppercase text-deploy-blue">{category}</p>
          <h3 class="mt-3 text-[24px] font-normal leading-tight">{title}</h3>
          <p class="mt-3 text-[16px] leading-[1.45] text-[#555b63]">{text}</p>
        </div>
      </article>
    ))}
  </div>
</section>
