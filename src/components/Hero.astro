---
const clients = [
  { src: 'assets/client-jobmate.svg', alt: 'Jobmate' },
  { src: 'assets/client-barter-black.svg', alt: 'Barter Black' },
  { src: 'assets/client-commshq.svg', alt: 'Comms HQ' },
  { src: 'assets/client-newnorth.svg', alt: 'New North' },
  { src: 'assets/client-bysignal.svg', alt: 'Bysignal' },
  { src: 'assets/client-perksome.svg', alt: 'Perksome' },
];
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}${path}`;
---

<section class="pt-8 sm:pt-14">
  <div class="mx-auto max-w-[1120px] px-0">
    <div class="bg-hero-grid relative min-h-[500px] overflow-hidden px-4 pt-[86px] text-center sm:min-h-[520px] sm:pt-[58px]">
      <div class="absolute left-[9%] top-[70px] h-11 w-11 bg-slate-100/60"></div>
      <div class="absolute right-[17%] top-[122px] h-11 w-11 bg-slate-100/60"></div>
      <div class="absolute bottom-[126px] left-[19%] h-11 w-11 bg-slate-100/60"></div>

      <h1 class="mx-auto max-w-[713px] text-[56px] font-normal leading-[61.6px] tracking-normal text-[#030712] max-[770px]:text-[32px] max-[770px]:leading-[35.2px]">
        Bring your ideas to <em class="font-normal text-deploy-blue">life</em> in the fastest way possible
      </h1>
      <p class="mx-auto mt-6 max-w-[713px] text-[18px] leading-[25.2px] text-[#343a40] max-[770px]:text-[15px] max-[770px]:leading-[19.6px]">
        We connect you to an expert product team that is dedicated and saves you money on custom software
        development. Your product ideas can start coming to life in weeks instead of months.
      </p>
      <button
        type="button"
        data-share-idea-open
        class="mt-9 inline-flex rounded-[8px] bg-deploy-navy px-6 py-4 text-[18px] font-bold text-white transition hover:bg-deploy-blue"
      >
        Share my Idea
      </button>
    </div>
  </div>

  <div class="mx-auto mt-4 max-w-[900px] px-6 pb-[74px] text-center">
    <h2 class="text-[40px] font-normal leading-tight max-[770px]:text-[28px] max-[770px]:leading-[28px]">Our clients</h2>
    <div class="mt-9 flex flex-wrap items-center justify-center gap-x-14 gap-y-8 opacity-55 grayscale">
      {clients.map((client) => (
        <img src={asset(client.src)} alt={client.alt} class="max-h-8 w-auto object-contain" loading="lazy" />
      ))}
    </div>
  </div>
</section>
